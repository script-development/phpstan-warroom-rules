#!/usr/bin/env php
<?php

declare(strict_types = 1);

use ScriptDevelopment\PhpstanWarroomRules\DiffGuards\Application;

$autoload = $GLOBALS['_composer_autoload_path'] ?? null;

foreach ([$autoload, __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if (is_string($candidate) && is_file($candidate)) {
        require $candidate;

        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(\STDERR, "diff-guards: MISSING — no Composer autoloader found.\n");
    exit(2);
}

exit((new Application)->run(array_slice($argv, 1), (string) getcwd(), \STDOUT));
